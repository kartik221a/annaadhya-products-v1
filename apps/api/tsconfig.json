{
  "extends": "@annaadhya/config/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "types": ["node"],
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true
  },
  "include": ["src", "tests"]
}
