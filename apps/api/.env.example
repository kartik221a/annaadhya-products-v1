# Annaadhya API — example environment (placeholders only; never commit real secrets)
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Data provider: memory (mock, dev only) | firestore (production requires this)
DATA_PROVIDER=memory

# Firebase Admin SDK (required when DATA_PROVIDER=firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=

# Mock-mode dev tokens (dev/test only; production forbids mock auth)
DEV_TOKEN_SECRET=

# One-time owner bootstrap guard (choose a long random value)
ADMIN_SETUP_KEY=

# Payments
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Behaviour tuning
CHECKOUT_QUOTE_TTL_MINUTES=15
STOCK_RESERVATION_TTL_MINUTES=30
EXPORT_SYNC_ROW_LIMIT=20000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=240
