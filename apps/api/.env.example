# Annaadhya API — example environment (placeholders only; never commit real secrets)
# Every variable below is read by apps/api/src/config/env.ts (Zod-validated at boot)
# unless noted otherwise. Values shown are the recommended FIRST TEST DEPLOYMENT settings.

NODE_ENV=development
PORT=4000
# CORS is only relevant for cross-origin clients (e.g. local dev on :3000/:3001).
# On Vercel (services mode) the storefront/admin browsers call the API same-origin
# through the platform rewrite, which needs no CORS — leave CORS_ORIGINS unset there.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Data provider: memory (mock, dev only — boot-throws in production) | firestore
# FIRST TEST DEPLOYMENT: firestore (persistent). Requires the three FIREBASE_* vars below;
# the API refuses to boot with DATA_PROVIDER=firestore and any of them missing
# (apps/api/src/data/data.module.ts).
DATA_PROVIDER=firestore

# Firebase Admin SDK (service account) — required with DATA_PROVIDER=firestore, and
# required in production regardless of provider. Create at: Firebase console →
# Project settings → Service accounts → Generate new private key.
# FIREBASE_PRIVATE_KEY format: keep the FULL key on ONE line inside double quotes with
# literal \n escapes — the code converts them to real newlines
# (packages/data-core/src/firestore.provider.ts: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n")).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: only if you created a NAMED Firestore database (not the "(default)").
FIRESTORE_DATABASE_ID=

# Mock-mode dev tokens (POST /auth/v1 dev sign-in). Dev/test only — the endpoint refuses
# whenever Firebase credentials exist or NODE_ENV=production, and production forbids mock
# auth entirely. Min 16 chars. Generate: openssl rand -hex 32
DEV_TOKEN_SECRET=

# One-time owner bootstrap guard for POST /api/v1/auth/bootstrap-owner (min 8 chars).
# Needed to create the first admin owner. The endpoint refuses once an owner exists, but
# rotate this value afterwards anyway. Generate: openssl rand -hex 32
ADMIN_SETUP_KEY=

# Payments: mock (default, zero credentials) | razorpay.
# FIRST TEST DEPLOYMENT: mock — Razorpay keys are NOT required and should stay unset
# until go-live. NOTE: with Firebase configured (mandatory for firestore), the storefront
# mock-confirm endpoint POST /api/v1/payments/mock/confirm returns 403 by design
# (apps/api/src/modules/checkout/checkout.controller.ts) — see the deployment report.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HMAC secret for the signed mock webhook POST /api/v1/payments/webhook/mock
# (read directly in apps/api/src/modules/payments/mock.provider.ts). Optional — a default
# dev value exists — but set a strong one: openssl rand -hex 32
MOCK_WEBHOOK_SECRET=

# Media (Cloudinary). Optional for the first deployment; required for product image
# uploads through the admin panel. The API uses signed direct uploads — the secret is
# server-side only. Console: Cloudinary dashboard → Settings → Access Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Behaviour tuning (defaults shown; ranges enforced by Zod)
CHECKOUT_QUOTE_TTL_MINUTES=15
STOCK_RESERVATION_TTL_MINUTES=30
EXPORT_SYNC_ROW_LIMIT=20000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=240

# Storefront cache revalidation (optional). When both are set, CMS saves (pages,
# navigation, homepage, categories) push an on-demand revalidation to the
# storefront so changes appear within seconds instead of the 30-120s ISR TTL.
#   STOREFRONT_REVALIDATE_URL     e.g. https://your-storefront.example.com/revalidate
#   STOREFRONT_REVALIDATE_SECRET  any long random string; must match the
#                                 REVALIDATE_SECRET set on the storefront app.
STOREFRONT_REVALIDATE_URL=
STOREFRONT_REVALIDATE_SECRET=
