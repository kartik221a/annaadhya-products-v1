# Annaadhya Admin — environment
# Browser-side API base. OPTIONAL:
#   - On Vercel (services mode) leave it UNSET — the panel calls the same origin
#     under /api/v1 and the platform rewrite routes the request to the api service.
#   - For local development against a separately running API, point it at the API
#     (global prefix /api/v1 included; the API listens on :4000 by default).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
