# Server-side API base (server components fetch the catalogue directly from the API).
# On Vercel (services mode) this variable is INJECTED by the storefront service's
# binding to the api service — do NOT set it in the Vercel dashboard.
# Locally it is the API origin; a trailing /api/v1 is tolerated and normalized.
API_URL=http://localhost:4000

# Browser-side API base. OPTIONAL:
#   - On Vercel leave it UNSET — the browser calls the same origin under /api/v1
#     and the platform rewrite routes the request to the api service.
#   - For local development against a separately running API, point it at the API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public origin of this storefront (metadata, sitemap, robots). Set to the final
# production URL in the Vercel dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase client SDK (optional — mock-mode sign-in is used when unset)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
